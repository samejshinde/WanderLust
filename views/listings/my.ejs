<% layout("/layouts/boilarplate") %>

<body>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let listing of allListings){ %>
        <!-- <p> LISTING => <%= listing.owner %> </p>
        <p> USER => <%= currUser._id %> </p>
        <p> Match =><%= listing.owner._id.equals(currUser._id) %> </p> -->


        <% if(listing.owner._id.equals(currUser._id) ) {%>

        <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card" style="">
            <img src="<%=listing.image%>" class="card-img-top" alt="Listing Image" style="height: 20rem;" >
              <div class="card-img-overlay">  </div>

            <div class="card-body">
                <p class="card-text"><b><%= (listing.title).toLocaleString("en-In") %></b>
                <br>
                &#8377;<%= listing.price.toLocaleString("en-In") %>/night</p>
            </div>
        </div>
        </a>
    <% } %> 
    <% } %> 
</div>
</body>
