<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wonder Lust — Find Your Escape</title>

    <!-- Bootstrap 5 + Icons -->
    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
    />
    <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Google Font (clean, modern) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700&display=swap"
    rel="stylesheet"
    />

    <style>
        /* ----- global reset & base ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #faf8f6;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
        }

        /* ----- main card container ----- */
        .wonder-wrapper {
            width: 100%;
            max-width: 1440px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        .hero-card {
            background: #ffffff;
            border-radius: 3rem;
            padding: 4rem 3rem 3.5rem;
            box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.08);
            position: relative;
            overflow: hidden;
            min-height: 80vh;
            display: flex;
            align-items: center;
        }

        /* ----- minimalistic decorative blobs ----- */
        .blob {
            position: absolute;
            border-radius: 50%;
            opacity: 0.30;
            filter: blur(72px);
            pointer-events: none;
            z-index: 0;
        }

        .blob--1 {
            width: 420px;
            height: 420px;
            background: #ffb3b3;
            top: -120px;
            right: -80px;
        }

        .blob--2 {
            width: 340px;
            height: 340px;
            background: #b3d9ff;
            bottom: -100px;
            left: -60px;
        }

        .blob--3 {
            width: 200px;
            height: 200px;
            background: #ffd9b3;
            top: 50%;
            left: 40%;
            transform: translateY(-50%);
            opacity: 0.20;
        }

        /* ----- content (z-index to sit above blobs) ----- */
        .hero-content {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        /* ----- minimalistic graphics (floating shapes) ----- */
        .graphics-group {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
        }

        .graphic-item {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #f0edea;
            color: #1e1e1e;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            animation: float 6s ease-in-out infinite;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.02);
        }

        .graphic-item:nth-child(1) {
            width: 72px;
            height: 72px;
            font-size: 2rem;
            background: #ffddd6;
            animation-delay: 0s;
        }
        .graphic-item:nth-child(2) {
            width: 56px;
            height: 56px;
            font-size: 1.5rem;
            background: #d4e8ff;
            animation-delay: 0.6s;
        }
        .graphic-item:nth-child(3) {
            width: 88px;
            height: 88px;
            font-size: 2.4rem;
            background: #fff3d6;
            animation-delay: 1.2s;
        }
        .graphic-item:nth-child(4) {
            width: 48px;
            height: 48px;
            font-size: 1.3rem;
            background: #e0f0e0;
            animation-delay: 0.3s;
        }
        .graphic-item:nth-child(5) {
            width: 64px;
            height: 64px;
            font-size: 1.8rem;
            background: #f0e0ff;
            animation-delay: 0.9s;
        }

        .graphic-item:hover {
            transform: scale(1.06) translateY(-4px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04);
        }

        @keyframes float {
            0%,
            100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-12px);
            }
        }

        /* ----- typography ----- */
        .wonder-title {
            font-weight: 700;
            font-size: clamp(2.8rem, 8vw, 5.2rem);
            letter-spacing: -0.03em;
            line-height: 1.05;
            color: #1e1e1e;
            margin-bottom: 1rem;
        }

        .wonder-title .highlight {
            background: linear-gradient(145deg, #ff7a5a, #ff4d6d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .wonder-sub {
            font-size: clamp(1.05rem, 1.8vw, 1.4rem);
            font-weight: 300;
            color: #5a5a5a;
            max-width: 540px;
            margin: 0 auto 2.5rem;
            line-height: 1.6;
        }

        /* ----- button (Visit Wonderlust) ----- */
        .btn-wonder {
            background: #1e1e1e;
            color: #ffffff;
            border: none;
            padding: 0.9rem 3.2rem;
            border-radius: 60px;
            font-weight: 600;
            font-size: 1.15rem;
            letter-spacing: 0.3px;
            transition: all 0.3s ease;
            box-shadow: 0 8px 28px rgba(30, 30, 30, 0.12);
            position: relative;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
            color: #fff;
        }

        .btn-wonder i {
            font-size: 1.2rem;
            transition: transform 0.3s ease;
        }

        .btn-wonder:hover {
            background: #000000;
            color: #ffffff;
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 16px 40px rgba(30, 30, 30, 0.18);
        }

        .btn-wonder:hover i {
            transform: translateX(4px) rotate(-4deg);
        }

        /* landing animation (fade-up + scale) */
        .animate-landing {
            opacity: 0;
            transform: translateY(40px) scale(0.96);
            animation: landFade 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-landing--delay-1 {
            animation-delay: 0.15s;
        }
        .animate-landing--delay-2 {
            animation-delay: 0.35s;
        }
        .animate-landing--delay-3 {
            animation-delay: 0.60s;
        }

        @keyframes landFade {
            0% {
                opacity: 0;
                transform: translateY(40px) scale(0.96);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* subtle shimmer on button (optional) */
        .btn-wonder::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -60%;
            width: 60%;
            height: 200%;
            background: rgba(255, 255, 255, 0.06);
            transform: rotate(25deg);
            transition: all 0.5s ease;
            pointer-events: none;
        }

        .btn-wonder:hover::after {
            left: 120%;
        }

        /* ----- responsive tweaks ----- */
        @media (max-width: 768px) {
            .hero-card {
                padding: 2.5rem 1.5rem 2.5rem;
                border-radius: 2rem;
                min-height: auto;
            }

            .graphic-item:nth-child(1) {
                width: 56px;
                height: 56px;
                font-size: 1.5rem;
            }
            .graphic-item:nth-child(2) {
                width: 44px;
                height: 44px;
                font-size: 1.2rem;
            }
            .graphic-item:nth-child(3) {
                width: 68px;
                height: 68px;
                font-size: 1.9rem;
            }
            .graphic-item:nth-child(4) {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }
            .graphic-item:nth-child(5) {
                width: 50px;
                height: 50px;
                font-size: 1.4rem;
            }

            .btn-wonder {
                padding: 0.75rem 2.2rem;
                font-size: 1rem;
            }

            .blob--1 {
                width: 240px;
                height: 240px;
                top: -60px;
                right: -40px;
            }
            .blob--2 {
                width: 200px;
                height: 200px;
                bottom: -50px;
                left: -40px;
            }
            .blob--3 {
                width: 120px;
                height: 120px;
            }
        }

        @media (max-width: 480px) {
            .hero-card {
                padding: 2rem 1.2rem;
                border-radius: 1.5rem;
            }
            .graphics-group {
                gap: 0.5rem;
            }
            .wonder-title {
                font-size: 2.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="wonder-wrapper">
        <div class="hero-card">

            <!-- minimalistic blobs -->
            <div class="blob blob--1"></div>
            <div class="blob blob--2"></div>
            <div class="blob blob--3"></div>

            <!-- main content -->
            <div class="hero-content text-center">

                <!-- graphics group (minimalistic icons) -->
                <div class="graphics-group animate-landing animate-landing--delay-1">
                    <span class="graphic-item"><i class="bi bi-house-heart"></i></span>
                    <span class="graphic-item"><i class="bi bi-tree"></i></span>
                    <span class="graphic-item"><i class="bi bi-sun"></i></span>
                    <span class="graphic-item"><i class="bi bi-compass"></i></span>
                    <span class="graphic-item"><i class="bi bi-map"></i></span>
                </div>

                <!-- headline -->
                <h1 class="wonder-title animate-landing animate-landing--delay-2">
                    Find your<br />
                    <span class="highlight">Wonder Lust</span>
                </h1>

                <!-- subtext -->
                <p class="wonder-sub animate-landing animate-landing--delay-2">
                    Discover unique stays &amp; experiences — <br class="d-none d-sm-block" />
                    crafted for the curious soul.
                </p>

                <!-- call to action -->
                <div class="animate-landing animate-landing--delay-3">
                    <a href="/listings" class="btn-wonder">
                        Visit Wonderlust
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <!-- tiny footnote (optional) -->
                <p class="mt-4 text-muted small animate-landing animate-landing--delay-3" style="font-weight:300; letter-spacing:0.2px; opacity:0.6;">
                    <i class="bi bi-geo-alt"></i> 1,200+ homes · 80+ countries
                </p>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS (optional, for any toggles) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>
</body>
</html>